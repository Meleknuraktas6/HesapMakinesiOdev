<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HesapMakinesi.SettingsPage"
    Title="Ayarlar"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <VerticalStackLayout
        Padding="25"
        Spacing="20"
        BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

        <Label
            Text="Ayarlar"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>

        <Label
            Text="Uygulama Teması"
            FontSize="18"
            TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>

        <Picker
            x:Name="ThemePicker"
            Title="Tema seçiniz"
            TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
            TitleColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#454545}"
            SelectedIndexChanged="OnThemeChanged">

            <Picker.Items>
                <x:String>Açık Tema</x:String>
                <x:String>Koyu Tema</x:String>
                <x:String>Sistem Teması</x:String>
            </Picker.Items>

        </Picker>

    </VerticalStackLayout>

</ContentPage>
