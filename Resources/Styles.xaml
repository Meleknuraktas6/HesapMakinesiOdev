<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

   
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light=#E5E5E5, Dark=#454545}"/>
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light=#202020, Dark=#FFFFFF}"/>
    </Style>

    
    <Style TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}"/>

   
    <Style x:Key="NumberButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light=#FFFFFF, Dark=#303030}"/>
    </Style>

 
    <Style x:Key="OperatorButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="BackgroundColor" Value="#DCEBFA"/>
        <Setter Property="TextColor" Value="#202020"/>
    </Style>

   
    <Style x:Key="EqualButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="BackgroundColor" Value="#0078D4"/>
        <Setter Property="TextColor" Value="#FFFFFF"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

</ResourceDictionary>
